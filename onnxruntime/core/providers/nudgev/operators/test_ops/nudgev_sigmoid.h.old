#pragma once
#include "core/framework/op_kernel.h"
#include "core/framework/tensor.h"
#include "core/platform/threadpool.h"
#include "core/providers/nudgev/nudgev_execution_provider.h"
#include <vector>

namespace onnxruntime {
namespace nudgev {

struct alignas(32) SigmoidParams {
  float input_scale{};
  int8_t input_zp{};
  float output_scale{};
  int8_t output_zp{};

  int64_t batch_size{};
  bool dynamic_batch{false};
  std::vector<int64_t> input_shape;
};

Status ComputeNudgeVSigmoid(SigmoidParams* params, OrtKernelContext* context);

}  // namespace nudgev
}  // namespace onnxruntime