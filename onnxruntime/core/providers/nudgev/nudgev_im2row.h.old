#pragma once

#include <cstdint>
#include <cstring>
#include <vector>
#include <memory>
#include <immintrin.h>
#include "core/common/common.h"
#include <algorithm>
#include <cassert>
#include <stdexcept>

namespace onnxruntime {
namespace nudgev {

static inline std::vector<int32_t> PadAndCenterInput(
    const int8_t* input_data,
    int64_t N, int64_t C, int64_t H, int64_t W,
    int64_t pad_t, int64_t pad_b, int64_t pad_l, int64_t pad_r,
    int8_t input_zp) {
  const int64_t Hpad = H + pad_t + pad_b;
  const int64_t Wpad = W + pad_l + pad_r;
  const int64_t total_size = N * C * Hpad * Wpad;
  std::vector<int32_t> output_padded(total_size, 0);  // Zero perché sottraiamo input_zp

  for (int64_t n = 0; n < N; ++n) {
    for (int64_t c = 0; c < C; ++c) {
      const int64_t in_offset = (n * C + c) * H * W;
      const int64_t out_offset = (n * C + c) * Hpad * Wpad + pad_t * Wpad + pad_l;

      // Copiamo e centriamo riga per riga
      for (int64_t h = 0; h < H; ++h) {
        const int64_t in_row = in_offset + h * W;
        const int64_t out_row = out_offset + h * Wpad;

        // Convertiamo e centriamo l'intera riga
        for (int64_t w = 0; w < W; ++w) {
          output_padded[out_row + w] =
              static_cast<int32_t>(input_data[in_row + w]) - static_cast<int32_t>(input_zp);
        }
      }
    }
  }

  return output_padded;
}

static inline void im2row_k1_strided(
    const int32_t* input_padded,
    int64_t N, int64_t C, int64_t Hpad, int64_t Wpad,
    int64_t stride_h, int64_t stride_w,
    int32_t* output_col) {
  const int64_t out_h = (Hpad - 1) / stride_h + 1;
  const int64_t out_w = (Wpad - 1) / stride_w + 1;

  for (int64_t n = 0; n < N; ++n) {
    const int64_t batch_offset = n * C * Hpad * Wpad;

    for (int64_t oh = 0; oh < out_h; ++oh) {
      const int64_t ih = oh * stride_h;

      for (int64_t ow = 0; ow < out_w; ++ow) {
        const int64_t iw = ow * stride_w;
        const int64_t patch_idx = (n * out_h + oh) * out_w + ow;
        int32_t* patch_ptr = output_col + patch_idx * C;

        // Per kernel 1x1, copiamo direttamente tutti i canali
        // da una singola posizione
        const int64_t input_offset = batch_offset + ih * Wpad + iw;
        std::memcpy(patch_ptr, input_padded + input_offset, C * sizeof(int32_t));
      }
    }
  }
}

static inline void im2row_k3_strided(
    const int32_t* input_padded,
    int64_t N, int64_t C, int64_t Hpad, int64_t Wpad,
    int64_t stride_h, int64_t stride_w,
    int32_t* output_col) {
  const int64_t out_h = (Hpad - 3) / stride_h + 1;
  const int64_t out_w = (Wpad - 3) / stride_w + 1;
  const int64_t kernel_size = 3 * 3;

  for (int64_t n = 0; n < N; ++n) {
    const int64_t batch_offset = n * C * Hpad * Wpad;

    for (int64_t oh = 0; oh < out_h; ++oh) {
      const int64_t ih_base = oh * stride_h;

      for (int64_t ow = 0; ow < out_w; ++ow) {
        const int64_t iw_base = ow * stride_w;
        const int64_t patch_idx = (n * out_h + oh) * out_w + ow;
        int32_t* patch_ptr = output_col + patch_idx * (C * kernel_size);

        // Loop sui canali nell'iterazione più esterna
        for (int64_t c = 0; c < C; ++c) {
          const int64_t chan_offset = batch_offset + c * Hpad * Wpad;
          int32_t* out_chan = patch_ptr + c * kernel_size;

          // Copia blocchi contigui di memoria per ogni riga della finestra
          for (int64_t kh = 0; kh < 3; ++kh) {
            const int32_t* src_ptr = input_padded + chan_offset +
                                     (ih_base + kh) * Wpad + iw_base;
            std::memcpy(out_chan + kh * 3, src_ptr, 3 * sizeof(int32_t));
          }
        }
      }
    }
  }
}

static inline void im2row_k7_strided(
    const int32_t* input_padded,
    int64_t N, int64_t C, int64_t Hpad, int64_t Wpad,
    int64_t stride_h, int64_t stride_w,
    int32_t* output_col) {
  const int64_t out_h = (Hpad - 7) / stride_h + 1;
  const int64_t out_w = (Wpad - 7) / stride_w + 1;
  const int64_t kernel_size = 7 * 7;

  for (int64_t n = 0; n < N; ++n) {
    const int64_t batch_offset = n * C * Hpad * Wpad;

    for (int64_t oh = 0; oh < out_h; ++oh) {
      const int64_t ih_base = oh * stride_h;

      for (int64_t ow = 0; ow < out_w; ++ow) {
        const int64_t iw_base = ow * stride_w;
        const int64_t patch_idx = (n * out_h + oh) * out_w + ow;
        int32_t* patch_ptr = output_col + patch_idx * (C * kernel_size);

        // Loop sui canali nell'iterazione più esterna
        for (int64_t c = 0; c < C; ++c) {
          const int64_t chan_offset = batch_offset + c * Hpad * Wpad;
          int32_t* out_chan = patch_ptr + c * kernel_size;

          // Copia blocchi contigui di memoria per ogni riga della finestra 7x7
          for (int64_t kh = 0; kh < 7; ++kh) {
            const int32_t* src_ptr = input_padded + chan_offset +
                                     (ih_base + kh) * Wpad + iw_base;
            std::memcpy(out_chan + kh * 7, src_ptr, 7 * sizeof(int32_t));
          }
        }
      }
    }
  }
}

inline void im2row_special_dispatch(
    const int32_t* input_padded,
    int64_t N,
    int64_t C,
    int64_t Hpad,
    int64_t Wpad,
    int64_t KH,
    int64_t KW,
    int64_t stride_h,
    int64_t stride_w,
    int32_t* output_col) {
  // Controlliamo i 3 casi specializzati:
  if (KH == 7 && KW == 7) {
    // NB: controlliamo che stride_h, stride_w siano 1 o 2
    if ((stride_h != 1 && stride_h != 2) ||
        (stride_w != 1 && stride_w != 2)) {
      throw std::runtime_error("im2row_k7_strided supports only stride=1 or 2");
    }
    im2row_k7_strided(
        input_padded,
        N, C,
        Hpad, Wpad,
        stride_h, stride_w,
        output_col);

  } else if (KH == 3 && KW == 3) {
    if ((stride_h != 1 && stride_h != 2) ||
        (stride_w != 1 && stride_w != 2)) {
      throw std::runtime_error("im2row_k3_strided supports only stride=1 or 2");
    }
    im2row_k3_strided(
        input_padded,
        N, C,
        Hpad, Wpad,
        stride_h, stride_w,
        output_col);

  } else if (KH == 1 && KW == 1) {
    if ((stride_h != 1 && stride_h != 2) ||
        (stride_w != 1 && stride_w != 2)) {
      throw std::runtime_error("im2row_k1_strided supports only stride=1 or 2");
    }
    im2row_k1_strided(
        input_padded,
        N, C,
        Hpad, Wpad,
        stride_h, stride_w,
        output_col);

  } else {
    // fallback su implementazione generica
    throw std::runtime_error(
        "No specialized im2row for kernel=" + std::to_string(KH) + "x" +
        std::to_string(KW) + " stride=" + std::to_string(stride_h) + "x" +
        std::to_string(stride_w));
  }
}

}  // namespace nudgev
}  // namespace onnxruntime